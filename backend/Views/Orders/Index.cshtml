@model IEnumerable<LojaVirtual.Models.Order>
@{ ViewData["Title"] = "Pedidos"; }

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="admin-kicker mb-2">Operação</p><h2 class="admin-section-title mb-1">Pedidos da loja</h2><p class="text-secondary mb-0">Consulte status, valores e dados de entrega.</p></div></div>
<div class="admin-table-card"><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Ações</th></tr></thead><tbody>
@if (Model.Any()) { foreach (var item in Model.OrderByDescending(order => order.CreatedAt)) { <tr><td class="fw-semibold">#@item.Id</td><td><span class="d-block">@item.CustomerName</span><small class="text-secondary">@item.Email</small></td><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="admin-status">@item.Status</span></td><td class="text-end fw-semibold">@item.Total.ToString("C")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark admin-btn">Ver detalhes</a></td></tr> } } else { <tr><td colspan="6" class="admin-empty">Nenhum pedido cadastrado.</td></tr> }
</tbody></table></div></div>
