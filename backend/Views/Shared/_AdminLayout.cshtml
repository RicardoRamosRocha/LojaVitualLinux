@{
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Angel Acessórios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar d-none d-lg-flex">
            <partial name="_AdminSidebar" />
        </aside>

        <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminMenu" aria-labelledby="adminMenuLabel">
            <div class="offcanvas-header">
                <h2 class="offcanvas-title admin-brand" id="adminMenuLabel">Angel <span>Acessórios</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button>
            </div>
            <div class="offcanvas-body p-0"><partial name="_AdminSidebar" /></div>
        </div>

        <main class="admin-main">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="admin-menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMenu" aria-label="Abrir menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <p class="admin-kicker mb-1">Área administrativa</p>
                        <h1 class="admin-page-title">@ViewData["Title"]</h1>
                    </div>
                </div>
                <div class="admin-user">
                    <i class="bi bi-person-circle"></i>
                    <span>@(User.Identity?.Name ?? "Administrador")</span>
                </div>
            </header>

            <div class="admin-content">
                <nav class="admin-breadcrumb" aria-label="Breadcrumb">
                    <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                    <span>/</span>
                    <strong>@ViewData["Title"]</strong>
                </nav>
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
