@model LojaVirtual.Models.Product

@{
    ViewData["Title"] = "Detalhes do produto";
    var medias = Model.ProductMedias?.ToList() ?? new List<LojaVirtual.Models.ProductMedia>();
    var primaryMedia = medias.FirstOrDefault(media => media.Type == "image") ?? medias.FirstOrDefault();
    var additionalMedias = primaryMedia is null
        ? medias
        : medias.Where(media => media.Id != primaryMedia.Id).ToList();
    var carouselMedias = primaryMedia is null
        ? additionalMedias
        : new[] { primaryMedia }.Concat(additionalMedias).ToList();
}

<div class="admin-product-header">
    <div>
        <p class="admin-kicker mb-2">Catálogo / Produto</p>
        <h2 class="admin-section-title mb-1">@Model.Name</h2>
        <p class="text-secondary mb-0">Visualize os dados e as mídias cadastradas.</p>
    </div>
    <div class="admin-product-actions">
        <a asp-action="Index" class="btn btn-outline-dark admin-btn">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark admin-btn">
            <i class="bi bi-pencil-square me-2"></i>Editar
        </a>
    </div>
</div>

<div class="admin-product-detail">
    <section class="admin-card admin-product-media-card" aria-label="Mídias do produto">
        @if (primaryMedia is not null)
        {
            <div id="adminProductMediaCarousel" class="carousel slide" data-bs-interval="false">
                <div class="carousel-inner admin-product-carousel">
                    @for (var index = 0; index < carouselMedias.Count; index++)
                    {
                        var media = carouselMedias[index];
                        <div class="carousel-item @(index == 0 ? "active" : "")">
                            @if (media.Type == "image")
                            {
                                <img src="@media.Url" alt="@Model.Name" class="admin-product-main-media" />
                            }
                            else
                            {
                                <video controls class="admin-product-main-media" preload="metadata">
                                    <source src="@media.Url" type="video/mp4" />
                                </video>
                            }
                        </div>
                    }
                </div>

                @if (carouselMedias.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#adminProductMediaCarousel" data-bs-slide="prev" aria-label="Mídia anterior">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#adminProductMediaCarousel" data-bs-slide="next" aria-label="Próxima mídia">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>

            @if (additionalMedias.Count > 0)
            {
                <div class="admin-product-thumbnails" aria-label="Mídias adicionais">
                    @for (var index = 0; index < additionalMedias.Count; index++)
                    {
                        var media = additionalMedias[index];
                        var carouselIndex = index + 1;
                        <button type="button" class="admin-product-thumbnail" data-bs-target="#adminProductMediaCarousel" data-bs-slide-to="@carouselIndex" aria-label="Abrir mídia adicional @(index + 1)">
                            @if (media.Type == "image")
                            {
                                <img src="@media.Url" alt="" />
                            }
                            else
                            {
                                <span><i class="bi bi-play-fill"></i></span>
                            }
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div class="admin-product-empty-media">
                <i class="bi bi-image"></i>
                <span>Nenhuma mídia cadastrada</span>
            </div>
        }
    </section>

    <section class="admin-card admin-product-info-card" aria-label="Informações do produto">
        <div class="admin-product-info-topline">
            <span class="admin-status">Produto #@Model.Id</span>
            @if (Model.IsActive)
            {
                <span class="admin-status admin-status--success">Ativo</span>
            }
            else
            {
                <span class="admin-status">Inativo</span>
            }
        </div>

        <h1 class="admin-product-name">@Model.Name</h1>
        <div class="admin-product-price">@Model.Price.ToString("C")</div>

        <dl class="admin-product-facts">
            <div>
                <dt>Categoria</dt>
                <dd>@(Model.Category?.Name ?? "Sem categoria")</dd>
            </div>
            <div>
                <dt>Estoque</dt>
                <dd class="@(Model.Stock > 0 ? "text-success" : "text-danger")">@Model.Stock unidade(s)</dd>
            </div>
        </dl>

        <div class="admin-product-description">
            <h3>Descrição</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Nenhuma descrição cadastrada." : Model.Description)</p>
        </div>

        <div class="admin-product-flags">
            @if (Model.IsFeatured) { <span class="admin-status">Destaque</span> }
            @if (Model.IsNewCollection) { <span class="admin-status">Nova coleção</span> }
            @if (Model.IsBestSeller) { <span class="admin-status">Mais vendido</span> }
        </div>
    </section>
</div>
