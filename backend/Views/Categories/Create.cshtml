@model LojaVirtual.Models.Category
@{
    ViewData["Title"] = "Nova categoria";
}

<div class="admin-panel p-4 p-md-5" style="max-width: 720px;">
    <p class="admin-kicker mb-2">Catálogo</p>
    <h2 class="admin-section-title mb-1">Nova categoria</h2>
    <p class="text-secondary mb-4">Cadastre uma categoria para organizar seus produtos.</p>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-4">
            <label asp-for="Name" class="form-label fw-semibold">Nome</label>
            <input asp-for="Name" class="form-control form-control-lg" autocomplete="off" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-dark admin-btn">Salvar categoria</button>
            <a asp-action="Index" class="btn btn-outline-dark admin-btn">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
